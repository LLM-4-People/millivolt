# Deny by default: a build must never receive operator state or credentials.
**
!Dockerfile
!.dockerignore
!go.mod
!go.sum
!VERSION
!version.go
!LICENSE
!THIRD_PARTY_NOTICES.md
!proxy.example.yaml
!cmd/
!cmd/proxy/
!cmd/proxy/**
!internal/
!internal/**
!scripts/
!scripts/licenses/
!scripts/licenses/**
# These final rules also exclude private files nested inside allowed source.
# Keep the unanchored exclusions aligned with .gitignore.
**/.git
**/AGENTS.md
**/agents.md
**/*.test
**/*.out
**/*.prof
**/*.pprof
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/*.pid
**/.env
**/.env.*
**/*.local.yaml
**/*.local.yml
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/__pycache__/
**/*.py[cod]
**/.DS_Store
**/proxy.yaml
**/.proxy.yaml-*
# Dependencies, generated trees and local tool state. The allowlist above
# already denies these, but they must stay denied if a future COPY widens it.
**/containercheck
**/node_modules/
**/.venv/
**/site/
**/bin/
**/dist/
**/coverage/
**/test-results/
**/playwright-report/
**/.impeccable/
**/backups/
**/captures/
**/exports/
